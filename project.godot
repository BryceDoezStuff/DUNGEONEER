; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dungeoneers"
run/main_scene="res://Scenes/Main_Menu.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name=".Dungeoneers"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://Assets/Images/Logo/Team_Crown/KingLogo.png"
boot_splash/use_filter=false
config/icon="res://Assets/Images/Logo/APP/4.1/Dungeoneers 4.1.png"
config/windows_native_icon="res://Assets/Images/Logo/APP/4.1/Dungeoneers 4.1.ico"

[autoload]

Global="*res://Scripts/Global.gd"
Map="*res://Scripts/Map.gd"
SceneTrans="*res://scene_transition.tscn"
Room1="*res://rooms/Firstarea/room1/room1global.gd"
Room2="*res://rooms/Firstarea/room2/room2global.gd"
RoomS1="*res://rooms/Firstarea/Secret_Room_1/roomSglobal.gd"
Room3="*res://rooms/Firstarea/room3/room3global.gd"
Save="*res://save.gd"
Room4="*res://rooms/Firstarea/room4/room4global.gd"
Door="*res://door.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"

[dialogic]

glossary/default_case_sensitive=true
layout/styles={
"Default": {
"export_overrides": {
"name_label_font": "\"res://Fonts/Minecraft.ttf\"",
"next_indicator_texture": "\"res://Assets/Images/GUI/text_box/nextcon.png\"",
"typing_sounds_every_nths_character": "6.0"
},
"inherits": "",
"layout": "res://addons/dialogic/Modules/DefaultLayouts/Default/DialogicDefaultLayout.tscn"
},
"New Style": {
"layout": "res://DialogicDefaultLayout2.tscn"
},
"New Style 2": {},
"Styleiamusing": {
"export_overrides": {
"box_animation_new_text": "1",
"name_label_font": "\"res://Fonts/Minecraft.ttf\"",
"next_indicator_texture": "\"res://Assets/Images/GUI/text_box/nextcon.png\"",
"typing_sounds_every_nths_character": "6.0"
},
"inherits": "",
"layout": "res://addons/dialogic/Modules/DefaultLayouts/Default/DialogicDefaultLayout.tscn"
}
}
layout/default_style="res://charachters/Styles/Style_basic.tres"
variables={
"Talked_to": "false"
}
directories/dch_directory={
"Bob": "res://charachters/Bob.dch",
"adventure": "res://charachters/adventure.dch"
}
directories/dtl_directory={
"Eric_1": "res://charachters/timelines/Eric_1.dtl",
"eric_meat_seq": "res://charachters/timelines/eric_meat_seq.dtl",
"timeline": "res://charachters/timelines/timeline.dtl",
"timeline3434": "res://charachters/timelines/timeline3434.dtl"
}
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/join_default_wait=true
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
layout/style_list=["res://charachters/Styles/Style_basic.tres"]

[display]

window/size/mode=2
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

